# TMDB API Read Access Token (v4 auth) — the long "eyJ..." string, NOT the
# short v3 API key. Get one at themoviedb.org -> Settings -> API -> Developer
# (approval is instant). Free, no daily quota.
#
# Leave this EMPTY to run the app against the bundled fixtures in
# lib/tmdb/__fixtures__ — the whole UI works offline, just with a tiny catalog.
TMDB_ACCESS_TOKEN=

# Default region for "where to watch" providers and age certifications.
NEXT_PUBLIC_DEFAULT_REGION=UA
