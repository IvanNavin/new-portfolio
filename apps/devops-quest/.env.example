# Progress sync is OPTIONAL — the game is fully playable with none of these set
# (progress then lives in localStorage only).

# Shared Neon Postgres, same instance the other apps use.
POSTGRES_PRISMA_URL=

# Auth.js v5 JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client ID used by the One Tap sign-in card. The SAME client the
# devpulse and language apps use — but its "Authorized JavaScript origins" must
# list this app's domain too, or One Tap silently never appears.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
