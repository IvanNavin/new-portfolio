# Progress sync is OPTIONAL. With none of these set the game still works end to
# end — progress simply lives in localStorage and stays on this device.

# Shared Neon Postgres, the same instance the other apps use.
# Run the migration once before enabling sync:
#   cd packages/prisma && npx prisma migrate deploy
POSTGRES_PRISMA_URL=

# Auth.js v5 JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client id for the One Tap sign-in card — the same client the
# devpulse and language apps use. Its "Authorized JavaScript origins" must also
# list this app's domain, or One Tap silently never appears.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
